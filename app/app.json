{
  "expo": {
    "name": "Observed",
    "slug": "observed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1C1F1D",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1F1D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "day.observed.app"
    },
    "android": {
      "package": "day.observed.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1F1D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "69ac1370-17cb-4a7f-82a2-68fb897fc996"
      }
    },
    "owner": "dinkelbergg",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/69ac1370-17cb-4a7f-82a2-68fb897fc996"
    }
  }
}
