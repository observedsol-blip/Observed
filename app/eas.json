{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "diagnostics": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "diagnostics"
      },
      "credentialsSource": "local",
      "developmentClient": false,
      "channel": "diagnostics"
    },
    "tester": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "tester"
      },
      "credentialsSource": "local",
      "channel": "tester"
    }
  },
  "submit": {}
}
